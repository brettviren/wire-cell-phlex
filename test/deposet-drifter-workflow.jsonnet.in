{
  // PHLEX integration test workflow: DepoSet drift simulation.
  //
  // Reads muon-depos.npz (1 depo set) via wcph_deposet_source_file, runs the
  // WCT DepoSetDrifter to simulate ionisation drift (diffusion, lifetime,
  // x-region boundaries), and writes the drifted depo set to drifted-output.npz.
  //
  // total: 1 matches the single depo set in muon-depos.npz.
  //
  // File paths are substituted by CMake configure_file().
  // Requires WIRECELL_PATH to include wire-cell-phlex/cfg/ and WCT data dir
  // (for wirecell.jsonnet used by deposet-drifter.jsonnet).
  // Requires WireCellSio and WireCellGen plugins.

  driver: {
    cpp: 'generate_layers',
    layers: {
      event: { parent: 'job', total: 1, starting_number: 1 },
    },
  },
  sources: {
    deposet_source: {
      cpp: 'wcph_deposet_source_file',
      wct_config: 'deposet-file-source.jsonnet',
      wct_plugins: ['WireCellPgraph', 'WireCellSio'],
      output_layer: 'event',
      wct_tla: { inname: '@WCP_TEST_DATA_DIR@/muon-depos.npz' },
    },
  },
  modules: {
    deposet_drifter: {
      cpp: 'wcph_deposet_filter',
      phlex: {
        name: 'deposet_drifter',
        concurrency: 'serial',
        inputs: [{ creator: 'input', layer: 'event', suffix: 'deposet', stage: 'CURRENT' }],
        outputs: ['deposet'],
      },
      executor: {
        wct_config: 'deposet-drifter.jsonnet',
        wct_plugins: ['WireCellPgraph', 'WireCellGen'],
      },
    },
    deposet_sink: {
      cpp: 'wcph_deposet_sink_file',
      wct_config: 'deposet-file-sink.jsonnet',
      wct_plugins: ['WireCellPgraph', 'WireCellSio'],
      input_layer: 'event',
      input_from: 'deposet_drifter',
      wct_tla: { outname: '@WCP_OUTPUT_DIR@/drifted-output.npz' },
    },
  },
}
