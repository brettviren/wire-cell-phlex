// test/pdhd-sim-sigproc-workflow.jsonnet.in
//
// PHLEX integration test: PDHD single-APA sim+sigproc using the new factored
// dune/wct/job/sim-sigproc.jsonnet config.
//
// Tests that the factored detector-abstraction layer correctly generates a
// working PDHD APA @FACTORED_APA@ simulation + signal processing pipeline via
// the new wct/dets/pdhd/detector.jsonnet detector description.
//
// The APA index is substituted by CMake (configure_file), which generates one
// variant per APA.  APA 0 uses the np04hd "bad APA" best-fit field response;
// the other APAs use the nominal response (see dets/pdhd/detector.jsonnet).
//
// File paths are substituted by CMake configure_file().
// Requires WIRECELL_PATH to include:
//   wire-cell-phlex/cfg/           (for dune/ configs and utility jsonnet)
//   <wct-data-dir>/share/wirecell/ (for data files and wirecell.jsonnet)

local build = import "dune/phlex/job/sim-sigproc.jsonnet";

build(
    params      = { detname: "pdhd" },
    depo_file   = "@WCP_TEST_DATA_DIR@/muon-depos.npz",
    output_file = "@WCP_OUTPUT_DIR@/pdhd-sim-sigproc-apa@FACTORED_APA@-frames.npz",
    anode_index = @FACTORED_APA@,
    nevents     = 1,
)
