{
  // PHLEX integration test: single PDHD APA — DepoFileSource+Drifter → DepoTransform
  // + OmnibusSigProc → FrameFileSink.
  //
  // This workflow isolates one APA through the full sim+sigproc chain so that
  // per-APA crashes (notably the Eigen bounds assertion for apa_ident=3 with
  // drifted PDSP depos) can be reproduced and debugged independently of the
  // 4-APA fan topology.
  //
  // Four variants are generated by CMake:
  //   pdhd-apa0-sigproc-workflow.jsonnet  (apa_ident = "0")
  //   pdhd-apa1-sigproc-workflow.jsonnet  (apa_ident = "1")
  //   pdhd-apa2-sigproc-workflow.jsonnet  (apa_ident = "2")
  //   pdhd-apa3-sigproc-workflow.jsonnet  (apa_ident = "3")  ← currently crashes
  //
  // total: 1 matches the single drifted DepoSet produced from muon-depos.npz.
  //
  // File paths are substituted by CMake configure_file().
  // Requires WIRECELL_PATH to include:
  //   wire-cell-phlex/cfg/           (for pdhd-*.jsonnet, sp-filters.jsonnet)
  //   <wct-data-dir>/share/wirecell/ (for protodunehd-wires-larsoft-v1.json.bz2,
  //                                    dune-garfield-1d565.json.bz2, wirecell.jsonnet)
  // Required WCT plugins:
  //   source:  WireCellPgraph, WireCellSio, WireCellGen
  //   sim+sp:  WireCellPgraph, WireCellGen, WireCellSigProc, WireCellAux
  //   sink:    WireCellPgraph, WireCellSio

  driver: {
    cpp: 'generate_layers',
    layers: {
      event: { parent: 'job', total: 1, starting_number: 1 },
    },
  },
  sources: {
    depo_source: {
      cpp: 'wcph_deposet_source',
      wct_config: 'pdhd-file-drifter.jsonnet',
      wct_plugins: ['WireCellPgraph', 'WireCellSio', 'WireCellGen'],
      output_layer: 'event',
      wct_tla: { inname: '@WCP_TEST_DATA_DIR@/muon-depos.npz' },
    },
  },
  modules: {
    sim_sp: {
      cpp: 'wcph_deposet_to_frame',
      input_from: 'input',
      wct_config: 'pdhd-apa-sim-sigproc.jsonnet',
      wct_plugins: ['WireCellPgraph', 'WireCellGen', 'WireCellSigProc', 'WireCellAux'],
      input_layer: 'event',
      wct_tla: { apa_ident: '@APA_IDENT@' },
    },
    frame_sink: {
      cpp: 'wcph_frame_sink',
      wct_config: 'frame-file-sink.jsonnet',
      wct_plugins: ['WireCellPgraph', 'WireCellSio'],
      input_layer: 'event',
      input_from: 'sim_sp',
      wct_tla: { outname: '@WCP_OUTPUT_DIR@/pdhd-apa@APA_IDENT@-sigproc-frames.npz' },
    },
  },
}
