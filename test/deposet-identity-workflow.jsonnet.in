{
  // PHLEX integration test workflow: DepoSet identity round-trip.
  //
  // Reads muon-depos.npz (1 depo set, 32825 depositions) via wcph_deposet_source_file
  // and writes an identical copy to identity-output.npz via wcph_deposet_sink_file.
  // No processing occurs between source and sink; serves as a round-trip baseline.
  //
  // total: 1 matches the single depo set in muon-depos.npz.
  //
  // File paths are substituted by CMake configure_file().
  // Requires WIRECELL_PATH to include wire-cell-phlex/cfg/.
  // Requires WireCellSio plugin for DepoFileSource and DepoFileSink.

  driver: {
    cpp: 'generate_layers',
    layers: {
      event: { parent: 'job', total: 1, starting_number: 1 },
    },
  },
  sources: {
    deposet_source: {
      cpp: 'wcph_deposet_source_file',
      wct_config: 'deposet-file-source.jsonnet',
      wct_plugins: ['WireCellPgraph', 'WireCellSio'],
      output_layer: 'event',
      wct_tla: { inname: '@WCP_TEST_DATA_DIR@/muon-depos.npz' },
    },
  },
  modules: {
    deposet_sink: {
      cpp: 'wcph_deposet_sink_file',
      wct_config: 'deposet-file-sink.jsonnet',
      wct_plugins: ['WireCellPgraph', 'WireCellSio'],
      input_layer: 'event',
      input_from: 'input',
      wct_tla: { outname: '@WCP_OUTPUT_DIR@/identity-output.npz' },
    },
  },
}
