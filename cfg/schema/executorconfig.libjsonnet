// executorconfig.libjsonnet
// @brief Construct a ExecutorConfig object
// @param wct_config (string) Path to the WCT Jsonnet config file (required). A Jsonnet function accepting at least the source_name/sink_name/app_name TLAs.
// @param wct_app (string) WCT IApplication type used to build the add_app() name.
// @param wct_plugins (array) Additional WCT plugin libraries to load (e.g. WireCellPgraph).
// @param wct_tla (object) Extra Jsonnet top-level arguments (string -> string).
// @param module_label (string) Scope prefix for WCT component instance names. Empty selects the default scope 'wcphlex'.
// @param wct_log_sink (string) WCT log destination: 'stdout', 'stderr', or a file path. Empty = none.
// @param wct_log_level (string) WCT log level ('warn', 'info', 'debug', ...). Only used with wct_log_sink.
function (wct_config="", wct_app="Pgrapher", wct_plugins=[], wct_tla={}, module_label="", wct_log_sink="", wct_log_level="") { wct_config: wct_config, wct_app: wct_app, wct_plugins: wct_plugins, wct_tla: wct_tla, module_label: module_label, wct_log_sink: wct_log_sink, wct_log_level: wct_log_level }
